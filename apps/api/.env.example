# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Postgres 17 — see docker-compose) ─────────────────────────────
DATABASE_URL="postgresql://trinos:trinos_dev@localhost:5432/trinos_dev?schema=public"
# DIRECT_URL is used by Prisma Migrate when DATABASE_URL points at a pooler.
DIRECT_URL="postgresql://trinos:trinos_dev@localhost:5432/trinos_dev?schema=public"

# ─── Redis (db 0 = queues, db 1 = cache/blocklist) ──────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-16-chars"

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="Trinos <no-reply@trinos.ai>"

# ─── URLs / CORS ─────────────────────────────────────────────────────────────
APP_BASE_URL="http://localhost:3000"
# Comma-separated allowlist
CORS_ORIGINS="http://localhost:3000"

# ─── Session / login lockout ────────────────────────────────────────────────
SESSION_TIMEOUT_HOURS=8
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=30

# ─── Reporting policy ────────────────────────────────────────────────────────
REPORT_EDIT_WINDOW_MINUTES=60
REPORT_DEADLINE_LOCAL_TIME="18:00"
DEFAULT_TIMEZONE="Asia/Kolkata"
REPORT_RETENTION_MONTHS=12
